{
  "name": "onlineexcel",
  "version": "0.1.0",
  "description": "Embeddable browser spreadsheet with a self-contained calculation engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelSupe/onlineexcel.git"
  },
  "homepage": "https://github.com/SamuelSupe/onlineexcel#readme",
  "bugs": {
    "url": "https://github.com/SamuelSupe/onlineexcel/issues"
  },
  "keywords": ["spreadsheet", "excel", "xlsx", "typescript", "canvas", "web-worker"],
  "type": "module",
  "main": "./dist/onlineexcel.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./xlsx": {
      "types": "./dist/io/xlsx.d.ts",
      "import": "./dist/xlsx.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./worker": "./dist/worker.js",
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "examples",
    "src",
    "scripts/copy-assets.mjs"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/benchmark.ts",
    "functions": "tsx scripts/functions.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "qa:serve": "node scripts/serve-qa.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  },
  "license": "MIT",
  "bin": {
    "onlineexcel-copy-assets": "./scripts/copy-assets.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
