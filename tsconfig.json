{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "onlineexcel": [
        "./src/index.ts"
      ],
      "onlineexcel/react": [
        "./src/adapters/react.tsx"
      ],
      "onlineexcel/vue": [
        "./src/adapters/vue.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "examples",
    "demo",
    "vite.config.ts"
  ]
}
